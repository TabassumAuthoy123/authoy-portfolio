# ═══════════════════════════════════════════════════════════════
#   AUTHOY PORTFOLIO CMS — ENVIRONMENT VARIABLES TEMPLATE
#   Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────
# Local development (uses MongoDB Memory Server automatically if empty/placeholder):
MONGO_URI=mongodb://127.0.0.1:27017/portfolio
# Production (MongoDB Atlas — required for persistent data):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio

# ── Authentication ────────────────────────────────────────────
# IMPORTANT: Change this to a strong random secret in production!
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-strong-secret

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────
# Set to your frontend domain in production (e.g., https://yourdomain.com)
CLIENT_URL=http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# ── Cloudinary (File Uploads) ─────────────────────────────────
# Sign up at https://cloudinary.com and get your credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email (Password Reset OTP) ────────────────────────────────
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# ═══════════════════════════════════════════════════════════════
#   FRONTEND (client/.env) — Create a separate .env in client/
# ═══════════════════════════════════════════════════════════════
# VITE_API_URL=http://localhost:5000/api
# For production: VITE_API_URL=https://api.yourdomain.com/api

# ═══════════════════════════════════════════════════════════════
#   DEPLOYMENT GUIDE (any domain/hosting)
# ═══════════════════════════════════════════════════════════════
# 1. Set MONGO_URI to your MongoDB Atlas connection string
# 2. Set CLIENT_URL to your frontend domain
# 3. Set VITE_API_URL in client/.env to your backend API
# 4. Set JWT_SECRET to a cryptographically strong random string
# 5. Configure Cloudinary for image uploads
# 6. Configure Email for password reset OTP
# 7. Deploy backend to Vercel/Railway/Render, frontend to Vercel/Netlify
#
# Default admin credentials (from seed):
#   Email: authoy@email.com
#   Password: AuthoyAdmin@2026!
